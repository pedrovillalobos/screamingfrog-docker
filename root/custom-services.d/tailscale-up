#!/bin/bash
# Brings the Tailscale session up once the daemon is ready. If TS_AUTHKEY is
# empty, authenticate manually once with:
#   docker exec -it screamingfrog tailscale up [--exit-node=...]
# State persists in /config/tailscale across container re-creations.
if [ "${TS_ENABLED,,}" != "true" ] || ! command -v tailscale >/dev/null 2>&1; then
    exec sleep infinity
fi

sleep 5
while ! tailscale status --json >/dev/null 2>&1; do
    if [ -n "$TS_AUTHKEY" ]; then
        echo "[tailscale-up] Authenticating with auth key..."
        tailscale up \
            --authkey="$TS_AUTHKEY" \
            ${TS_EXIT_NODE:+--exit-node="$TS_EXIT_NODE"} \
            --accept-dns=false || true
    else
        echo "[tailscale-up] Waiting for manual login (TS_AUTHKEY is empty)."
    fi
    sleep 15
done

# Re-apply the exit node in case the saved state predates an env change
if [ -n "$TS_EXIT_NODE" ]; then
    tailscale set --exit-node="$TS_EXIT_NODE" 2>/dev/null || true
fi

echo "[tailscale-up] Connected. Outbound HTTP proxy: localhost:1056 (SOCKS5: 1055)."
exec sleep infinity
