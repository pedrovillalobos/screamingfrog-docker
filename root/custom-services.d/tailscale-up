#!/usr/bin/with-contenv bash
# Applies the exit node once the user has authenticated. Authentication is
# MANUAL by design — no auth keys are stored in container config or env vars:
#   docker exec -it <container> tailscale up --exit-node=NODE
# The session state persists in /config/tailscale, so login is needed only
# once (and again only if you wipe that state directory).
if [ "${TS_ENABLED,,}" != "true" ] || ! command -v tailscale >/dev/null 2>&1; then
    exec sleep infinity
fi

sleep 5
while true; do
    STATE="$(tailscale status --json 2>/dev/null | grep -o '"BackendState": *"[^"]*"' | cut -d'"' -f4)"
    case "$STATE" in
        Running)
            # Keep container DNS untouched: in userspace mode, accepting
            # Tailscale DNS points resolv.conf at 100.100.100.100, which is
            # unreachable without a TUN device. A manual `tailscale up` resets
            # this preference, so re-apply it on every connect.
            tailscale set --accept-dns=false 2>/dev/null || true
            # Re-apply the exit node in case the saved state predates an env change
            if [ -n "$TS_EXIT_NODE" ]; then
                tailscale set --exit-node="$TS_EXIT_NODE" 2>/dev/null || true
            fi
            echo "[tailscale-up] Connected. Outbound HTTP proxy: localhost:1056 (SOCKS5: 1055)."
            exec sleep infinity
            ;;
        NeedsLogin|"")
            echo "[tailscale-up] Waiting for manual login: docker exec -it <container> tailscale up"
            ;;
        *)
            echo "[tailscale-up] Backend state: ${STATE}"
            ;;
    esac
    sleep 15
done
