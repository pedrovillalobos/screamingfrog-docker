#!/bin/bash
# The native SF MCP server (v24+) listens on 127.0.0.1:11435 inside the
# container. This relay exposes it on 0.0.0.0:11436 so the port can be
# published to the LAN. Retry loop: the MCP endpoint only exists after the
# app is running and the user enables Settings > MCP Server.
while true; do
    socat TCP-LISTEN:11436,fork,reuseaddr TCP:127.0.0.1:11435
    echo "[mcp-relay] socat exited, restarting in 5s..."
    sleep 5
done
